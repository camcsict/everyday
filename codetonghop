function doGet(e) {
  var output = ContentService.createTextOutput();
  output.setMimeType(ContentService.MimeType.JSON);
  
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    
    // 1. Get Settings (Tab 2)
    var settingsSheet = ss.getSheetByName("Settings");
    var settingsData = settingsSheet.getDataRange().getValues();
    var headers = settingsData[0];
    var checkboxes = settingsData[1];
    var activeColumns = [];
    
    for (var i = 0; i < headers.length; i++) {
      if (checkboxes[i] === true || String(checkboxes[i]).toUpperCase() === 'TRUE') {
        activeColumns.push(headers[i]);
      }
    }
    
    // 2. Get Students and Classes (Tab 1)
    var studentSheet = ss.getSheetByName("Students");
    var studentData = studentSheet.getDataRange().getValues();
    var students = [];
    var classesSet = {};
    
    for (var j = 1; j < studentData.length; j++) {
      var row = studentData[j];
      if (row[0]) { // If ID exists
        var className = row[1];
        classesSet[className] = true;
        
        students.push({
          id: row[0],
          className: className,
          fullName: row[2],
          nickname: row[3]
        });
      }
    }
    
    var uniqueClasses = Object.keys(classesSet).sort();
    
    return output.setContent(JSON.stringify({
      success: true,
      classes: uniqueClasses,
      students: students,
      trackingColumns: activeColumns
    }));
    
  } catch (error) {
    return output.setContent(JSON.stringify({ success: false, error: error.toString() }));
  }
}

function doPost(e) {
  var output = ContentService.createTextOutput();
  output.setMimeType(ContentService.MimeType.JSON);
  
  try {
    var data = JSON.parse(e.postData.contents);
    var recordsSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Records");
    var timestamp = new Date();
    
    // Prepare rows for batch insertion
    var rowsToAppend = [];
    
    for (var i = 0; i < data.attendance.length; i++) {
      var record = data.attendance[i];
      // Format tracking data as string
      var trackingString = "";
      for (var key in record.tracking) {
        trackingString += key + ": " + record.tracking[key] + " | ";
      }
      
      rowsToAppend.push([
        timestamp,
        data.teacherName,
        data.className,
        record.studentId,
        record.studentName,
        trackingString,
        record.note
      ]);
    }
    
    // Append all rows at once
    if (rowsToAppend.length > 0) {
      recordsSheet.getRange(recordsSheet.getLastRow() + 1, 1, rowsToAppend.length, rowsToAppend[0].length).setValues(rowsToAppend);
    }
    
    return output.setContent(JSON.stringify({ success: true, message: "Attendance saved successfully!" }));
    
  } catch (error) {
    return output.setContent(JSON.stringify({ success: false, error: error.toString() }));
  }
}
