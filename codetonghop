function doGet(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. Lấy dữ liệu học sinh
  var studentSheet = ss.getSheetByName("Students");
  var sData = studentSheet.getDataRange().getValues();
  var students = [];
  
  for(var i = 1; i < sData.length; i++) {
    if(sData[i][0]) {
      students.push({
        id: sData[i][0],
        class: sData[i][1],
        fullName: sData[i][2],
        nickname: sData[i][3],
        gender: sData[i][4]
      });
    }
  }

  // 2. Lấy dữ liệu Comment Bank
  var bankSheet = ss.getSheetByName("Bank");
  var bData = bankSheet.getDataRange().getValues();
  var commentBank = { adjectives: [], objectives: [], futures: [] };
  
  for(var j = 1; j < bData.length; j++) {
    var category = String(bData[j][0]).trim();
    var stars = parseInt(bData[j][1]);
    var text = bData[j][2];
    
    if(category === "Adjective") commentBank.adjectives.push({text: text, stars: stars});
    if(category === "Objective") commentBank.objectives.push({text: text, stars: stars});
    if(category === "Future") commentBank.futures.push({text: text, stars: stars});
  }

  // Trả về JSON
  return ContentService.createTextOutput(JSON.stringify({
    success: true,
    students: students,
    commentBank: commentBank
  })).setMimeType(ContentService.MimeType.JSON);
}
