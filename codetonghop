                            <option value="Term 2">Term 2</option>
                            <option value="Term 3">Term 3</option>
                        </select>
                    </div>
                    <div>
                        <label>Performance Rating:</label>
                        <select id="starSelect" class="star-select" onchange="filterBanks()">
                            <option value="5">5 ⭐⭐⭐⭐⭐ (Excellent)</option>
                            <option value="4">4 ⭐⭐⭐⭐ (Good)</option>
                            <option value="3" selected>3 ⭐⭐⭐ (Average)</option>
                            <option value="2">2 ⭐⭐ (Below Average)</option>
                            <option value="1">1 ⭐ (Needs Help)</option>
                        </select>
                    </div>
                </div>
                
                <div id="studentInfo" class="student-info">
                    <span id="genderIcon"></span> <span id="displayName"></span> (<span id="studentClass"></span>)
                </div>
            </div>

            <!-- Step 2: Adjectives -->
            <div class="card">
                <h2>✨ Step 2: Personality Traits (Max 3)</h2>
                <div class="checkbox-group" id="adjectivesBox">
                    <span class="loading-text">Loading traits...</span>
                </div>
            </div>

            <!-- Step 3: Academic Objectives -->
            <div class="card">
                <h2>🎯 Step 3: Achievements & Future Goals</h2>
                
                <label>Academic Achievement:</label>
                <select id="objectiveSelect" onchange="generatePreview()">
                    <option value="">-- Waiting for database --</option>
                </select>

                <label>Future Development / Area of Improvement:</label>
                <select id="futureSelect" onchange="generatePreview()">
                    <option value="">-- Waiting for database --</option>
                </select>
            </div>

            <!-- Step 4: Custom Comments -->
            <div class="card">
                <h2>✍️ Step 4: Additional Comments (Optional)</h2>
                <label>Do you want to add any specific notes?</label>
                <textarea id="customComment" rows="3" placeholder="Type any additional comments here... (This will be appended to the end of the report)" oninput="generatePreview()"></textarea>
            </div>
        </div>

        <!-- RIGHT PANEL: LIVE PREVIEW -->
        <div class="right-panel">
            <div class="card">
                <h2>👁️ Live Report Preview</h2>
                <div id="previewBox" class="preview-box">Loading Database... Please wait.</div>
                <button onclick="copyReport()">📋 Copy Final Report</button>
            </div>
        </div>
    </div>

    <script>
        // --- BƯỚC QUAN TRỌNG: DÁN WEB APP URL CỦA BẠN VÀO ĐÂY ---
        const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbzHh_5lYlbZ9686jO4Xc_swdfT6aIYzjT05u3LR4XaPCD-aVqCtQ86HjWSQMhNBjIvE/exec"; 

        // Khởi tạo biến trống để nhận dữ liệu từ Google Sheet
        let students = [];
        let commentBank = { adjectives: [], objectives: [], futures: [] };
        let currentStudent = null;

        // --- FETCH DỮ LIỆU TỪ GOOGLE SHEET KHI MỞ WEB ---
        window.onload = async () => {
            try {
                const response = await fetch(WEB_APP_URL);
                const data = await response.json();
                
                if (data.success) {
                    students = data.students;
                    commentBank = data.commentBank;
                    
                    // Đổ dữ liệu vào Dropdown Học sinh
                    const studentSelect = document.getElementById('studentSelect');
                    studentSelect.innerHTML = '<option value="">-- Choose Student --</option>';
                    students.forEach(s => {
                        studentSelect.innerHTML += `<option value="${s.id}">${s.fullName} (${s.id})</option>`;
                    });
                    
                    document.getElementById('previewBox').innerText = "Select a student and options on the left to see the generated report here...";
                    
                    // Kích hoạt bộ lọc mặc định (3 sao)
                    filterBanks();
                }
            } catch (error) {
                console.error("Error fetching data:", error);
                document.getElementById('studentSelect').innerHTML = '<option value="">Error Loading Data</option>';
                document.getElementById('previewBox').innerText = "Failed to connect to Google Sheets. Please check your WEB_APP_URL and deployment settings.";
            }
        };

        // --- XỬ LÝ LOGIC UI ---
        function loadStudentData() {
            const selectedId = document.getElementById('studentSelect').value;
            currentStudent = students.find(s => s.id === selectedId);

            if (currentStudent) {
                document.getElementById('studentInfo').style.display = 'block';
                document.getElementById('genderIcon').innerText = currentStudent.gender === 'M' ? '👦' : '👧';
                document.getElementById('displayName').innerText = currentStudent.nickname;
                document.getElementById('studentClass').innerText = currentStudent.class;
            } else {
                document.getElementById('studentInfo').style.display = 'none';
            }
            generatePreview();
        }

        function filterBanks() {
            if (commentBank.adjectives.length === 0) return; // Database chưa tải xong

            const currentStar = parseInt(document.getElementById('starSelect').value);
            const allowedStars = [currentStar - 1, currentStar, currentStar + 1]; // Bộ lọc tịnh tiến

            // Lọc Adjectives
            const adjBox = document.getElementById('adjectivesBox');
            adjBox.innerHTML = '';
            const filteredAdjs = commentBank.adjectives.filter(a => allowedStars.includes(a.stars));
            filteredAdjs.forEach(adj => {
                adjBox.innerHTML += `
                    <label class="checkbox-label">
                        <input type="checkbox" value="${adj.text}" onchange="limitCheckboxes(this); generatePreview()">
                        <span class="star-badge">${adj.stars}⭐</span> ${adj.text}
                    </label>`;
            });

            // Lọc Objectives
            const objSelect = document.getElementById('objectiveSelect');
            objSelect.innerHTML = '<option value="">-- Select an achievement --</option>';
            const filteredObjs = commentBank.objectives.filter(o => allowedStars.includes(o.stars));
            filteredObjs.forEach(obj => {
                objSelect.innerHTML += `<option value="${obj.text}">[${obj.stars}⭐] ${obj.text}</option>`;
            });

            // Lọc Futures
            const futSelect = document.getElementById('futureSelect');
            futSelect.innerHTML = '<option value="">-- Select a future goal --</option>';
            const filteredFuts = commentBank.futures.filter(f => allowedStars.includes(f.stars));
            filteredFuts.forEach(fut => {
                futSelect.innerHTML += `<option value="${fut.text}">[${fut.stars}⭐] ${fut.text}</option>`;
            });

            generatePreview(); 
        }

        function limitCheckboxes(checkbox) {
            const checkedBoxes = document.querySelectorAll('#adjectivesBox input:checked');
            if (checkedBoxes.length > 3) {
                checkbox.checked = false;
                alert("Please select a maximum of 3 traits.");
            }
        }

        function generatePreview() {
            const previewBox = document.getElementById('previewBox');
            
            if (!currentStudent) {
                previewBox.innerText = "Select a student and options on the left to see the generated report here...";
                return;
            }

            // Thiết lập đại từ nhân xưng
            const isMale = currentStudent.gender === 'M';
            const proSubj = isMale ? "he" : "she";
            const proSubjCap = isMale ? "He" : "She";
            const proObj = isMale ? "him" : "her";
            const proPoss = isMale ? "his" : "her";

            const name = currentStudent.nickname;
            const term = document.getElementById('termSelect').value;
            const objective = document.getElementById('objectiveSelect').value;
            let future = document.getElementById('futureSelect').value;
            const customComment = document.getElementById('customComment').value.trim();

            // Xử lý logic ghép chữ Adjectives (1 tính từ, 2 tính từ, 3 tính từ)
            const checkedAdjs = Array.from(document.querySelectorAll('#adjectivesBox input:checked')).map(cb => cb.value);
            let adjText = "";
            if (checkedAdjs.length === 1) adjText = checkedAdjs[0];
            else if (checkedAdjs.length === 2) adjText = `${checkedAdjs[0]} and ${checkedAdjs[1]}`;
            else if (checkedAdjs.length === 3) adjText = `${checkedAdjs[0]}, ${checkedAdjs[1]}, and ${checkedAdjs[2]}`;

            // Tự động thay thế Pronouns trong câu Future
            if (future) {
                future = future.replace(/\[he\/she\]/g, proSubj)
                               .replace(/\[He\/She\]/g, proSubjCap)
                               .replace(/\[him\/her\]/g, proObj)
                               .replace(/\[his\/her\]/g, proPoss);
            }

            // Gắn kết thành đoạn văn hoàn chỉnh
            let report = "";
            
            if (adjText) { report += `${name} is a ${adjText} student. `; } 
            else { report += `${name} is a student in ${currentStudent.class}. `; }

            if (objective) { report += `During ${term}, ${proSubj} ${objective}. `; }
            if (future) { report += `${future} `; }
            if (customComment) { report += `\n\n${customComment}`; }

            previewBox.innerText = report.trim();
        }

        function copyReport() {
            const previewBox = document.getElementById('previewBox');
            const textToCopy = previewBox.innerText;
            
            if (!currentStudent || textToCopy.includes("Select a student")) {
                alert("Nothing to copy yet!");
                return;
            }

            navigator.clipboard.writeText(textToCopy).then(() => {
                alert("✅ Report successfully copied to clipboard!");
            }).catch(err => {
                alert("Failed to copy. Please try selecting the text manually.");
            });
        }
    </script>
</body>
</html>
