<body>

    <div class="layout">
        <!-- LEFT PANEL: CONTROLS & SELECTION -->
        <div class="left-panel">
            
            <!-- Step 1: Student & Rating -->
            <div class="card">
                <h2>👤 Step 1: Student & Performance Level</h2>
                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 15px;">
                    <div>
                        <label>Select Student:</label>
                        <select id="studentSelect" onchange="loadStudentData()">
                            <option value="">-- Connecting to Database... --</option>
