function doGet(e) {
  // Set headers for CORS
  var output = ContentService.createTextOutput();
  output.setMimeType(ContentService.MimeType.JSON);
  
  var id = e.parameter.id;
  if (!id) {
    return output.setContent(JSON.stringify({ error: "Please enter a Student ID." }));
  }

  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();

  if (data.length < 3) {
    return output.setContent(JSON.stringify({ error: "Database is empty or missing setup." }));
  }

  var headers = data[0]; // Row 1: Headers
  var permissions = data[1]; // Row 2: Checkboxes (TRUE/FALSE)
  
  var studentData = null;

  // Find the student by ID (Column A is index 0)
  for (var i = 2; i < data.length; i++) {
    if (String(data[i][0]) === String(id)) {
      studentData = data[i];
      break;
    }
  }

  if (!studentData) {
    return output.setContent(JSON.stringify({ error: "Student ID not found." }));
  }

  var result = {};
  
  // Filter data based on permissions (Row 2)
  for (var j = 0; j < headers.length; j++) {
    var isAllowed = (permissions[j] === true || String(permissions[j]).toUpperCase() === 'TRUE');
    if (isAllowed) {
      result[headers[j]] = studentData[j];
    }
  }

  return output.setContent(JSON.stringify({ success: true, data: result }));
}
