    <script>
        // BƯỚC QUAN TRỌNG: DÁN WEB APP URL CỦA BẠN VÀO ĐÂY
        const WEB_APP_URL = "Nhap URL";
        
        let globalData = null;
        let currentClass = "";
        let zoomLevel = 16; // Font size base

        // Tải danh sách lớp khi mở trang
        window.onload = async () => {
            const loadBtn = document.getElementById('loadBtn');
            loadBtn.innerText = "Connecting...";
            try {
                const response = await fetch(WEB_APP_URL);
                const json = await response.json();
                if (json.success) {
                    globalData = json;
                    const select = document.getElementById('classSelect');
                    json.classes.forEach(cls => {
                        let opt = document.createElement('option');
                        opt.value = cls;
                        opt.innerText = cls;
                        select.appendChild(opt);
                    });
                    loadBtn.innerText = "Load Students";
                }
            } catch (err) {
                document.getElementById('errorMsg').innerText = "Connection failed. Please check the URL.";
                document.getElementById('errorMsg').style.display = 'block';
            }
        };

        function fetchData() {
            const tName = document.getElementById('teacherName').value.trim();
            currentClass = document.getElementById('classSelect').value;

            if (!tName || !currentClass) {
                alert("Please enter your name and select a class!");
                return;
            }

            document.getElementById('mainContent').style.display = 'block';
            renderTable();
        }

        function renderTable() {
            const thead = document.getElementById('tableHeader');
            const tbody = document.getElementById('tableBody');
            
            // Xóa header cũ, chỉ giữ ID và Name
            thead.innerHTML = '<th>ID</th><th class="text-left">Student Name</th>';
            globalData.trackingColumns.forEach(col => {
                thead.innerHTML += `<th>${col}</th>`;
            });
            thead.innerHTML += '<th>Note</th>';

            tbody.innerHTML = '';
            
            // Lọc học sinh theo lớp
            const students = globalData.students.filter(s => s.className === currentClass);
            
            students.forEach(std => {
                let tr = document.createElement('tr');
                tr.setAttribute('data-id', std.id);
                tr.setAttribute('data-name', std.fullName);
                
                let html = `
                    <td>${std.id}</td>
                    <td class="text-left"><b>${std.fullName}</b><br><small>${std.nickname}</small></td>
                `;

                globalData.trackingColumns.forEach(col => {
                    html += `
                        <td>
                            <button class="emoji-btn" data-col="${col}" onclick="cycleEmoji(this)">
                                ${col.split(' ')[0]} <!-- Lấy emoji ra nếu có -->
                            </button>
                        </td>
                    `;
                });

                html += `<td><input type="text" class="note-input" placeholder="Type note..."></td>`;
                tr.innerHTML = html;
                tbody.appendChild(tr);
            });
        }

        // Logic thay thế nhấp đúp: Gray -> Green -> Red -> Gray
        function cycleEmoji(btn) {
            if (!btn.classList.contains('green') && !btn.classList.contains('red')) {
                btn.classList.add('green'); // Lần 1: Xanh
            } else if (btn.classList.contains('green')) {
                btn.classList.remove('green');
                btn.classList.add('red');   // Lần 2 (Nhấp đúp): Đỏ
            } else {
                btn.classList.remove('red'); // Lần 3: Reset
            }
        }

        function markAllGreen() {
            document.querySelectorAll('.emoji-btn').forEach(btn => {
                btn.classList.remove('red');
                btn.classList.add('green');
            });
        }

        // --- HỆ THỐNG REVIEW BẮT BUỘC (FORCE REVIEW) ---
        function openReview() {
            // 1. Ép buộc kiểm tra: Tất cả checkbox phải được tick (Xanh hoặc Đỏ), không được để Xám
            const allBtns = document.querySelectorAll('.emoji-btn');
            let isAllMarked = true;
            for (let btn of allBtns) {
                if (!btn.classList.contains('green') && !btn.classList.contains('red')) {
                    isAllMarked = false;
                    break;
                }
            }

            if (!isAllMarked) {
                alert("⚠️ WARNING: You must mark ALL items (Green or Red) for ALL students before reviewing!");
                return;
            }

            // 2. Build dữ liệu Review
            const reviewHead = document.getElementById('reviewHeader');
            reviewHead.innerHTML = document.getElementById('tableHeader').innerHTML;
            
            const reviewBody = document.getElementById('reviewBody');
            reviewBody.innerHTML = '';

            const rows = document.getElementById('tableBody').querySelectorAll('tr');
            
            rows.forEach(row => {
                let tr = document.createElement('tr');
                let tdId = `<td>${row.cells[0].innerHTML}</td>`;
                let tdName = `<td class="text-left">${row.cells[1].innerHTML}</td>`;
                
                let tdTracking = '';
                const btns = row.querySelectorAll('.emoji-btn');
                btns.forEach(btn => {
                    let status = btn.classList.contains('green') ? '<span style="color:var(--success); font-weight:bold;">✔ DONE</span>' : '<span style="color:var(--danger); font-weight:bold;">❌ MISSED</span>';
                    tdTracking += `<td>${status}</td>`;
                });

                // Hiển thị note rõ ràng dù có hay không
                const noteVal = row.querySelector('.note-input').value.trim();
                const displayNote = noteVal ? noteVal : `<span class="empty-note">[No Note Entered]</span>`;
                let tdNote = `<td>${displayNote}</td>`;

                tr.innerHTML = tdId + tdName + tdTracking + tdNote;
                reviewBody.appendChild(tr);
            });

            // 3. Hiển thị chế độ Full Screen Modal
            document.getElementById('reviewModal').style.display = 'flex';
            document.getElementById('confirmCheck').checked = false;
            document.getElementById('submitBtn').disabled = true;
        }

        function closeReview() {
            document.getElementById('reviewModal').style.display = 'none';
        }

        function changeZoom(step) {
            zoomLevel += step;
            if (zoomLevel < 12) zoomLevel = 12;
            if (zoomLevel > 30) zoomLevel = 30;
            document.getElementById('reviewContainer').style.fontSize = zoomLevel + 'px';
        }

        function toggleSubmitBtn() {
            const isChecked = document.getElementById('confirmCheck').checked;
            document.getElementById('submitBtn').disabled = !isChecked;
        }

        // POST DATA TO GOOGLE SHEET
        async function submitData() {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.innerText = "Submitting Data...";
            submitBtn.disabled = true;

            const teacherName = document.getElementById('teacherName').value;
            const rows = document.getElementById('tableBody').querySelectorAll('tr');
            
            let attendanceData = [];

            rows.forEach(row => {
                let studentId = row.getAttribute('data-id');
                let studentName = row.getAttribute('data-name');
                let tracking = {};
                
                row.querySelectorAll('.emoji-btn').forEach(btn => {
                    let colName = btn.getAttribute('data-col');
                    tracking[colName] = btn.classList.contains('green') ? 'DONE' : 'MISSED';
                });

                let note = row.querySelector('.note-input').value.trim();

                attendanceData.push({
                    studentId: studentId,
                    studentName: studentName,
                    tracking: tracking,
                    note: note ? note : "None"
                });
            });

            const payload = {
                teacherName: teacherName,
                className: currentClass,
                attendance: attendanceData
            };

            try {
                const response = await fetch(WEB_APP_URL, {
                    method: 'POST',
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert("✅ Attendance submitted successfully!");
                    window.location.reload(); // Tải lại trang sau khi hoàn tất
                } else {
                    alert("Error: " + result.error);
                    submitBtn.innerText = "Confirm & Submit Data";
                    submitBtn.disabled = false;
                }
            } catch (e) {
                alert("Network error while submitting.");
                submitBtn.innerText = "Confirm & Submit Data";
                submitBtn.disabled = false;
            }
        }
    </script>
</body>
</html>
