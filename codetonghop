        function handleKeyPress(e) {
            if (e.key === 'Enter') {
                searchData();
            }
        }

        async function searchData() {
            const idInput = document.getElementById('studentId').value.trim();
            const messageBox = document.getElementById('messageBox');
            const resultContainer = document.getElementById('resultContainer');
            const searchBtn = document.getElementById('searchBtn');

            if (!idInput) {
                showMessage("Please enter your Student ID.", "error");
                resultContainer.style.display = "none";
                return;
            }

            // Reset UI
            resultContainer.style.display = "none";
            resultContainer.innerHTML = '';
            searchBtn.disabled = true;
            searchBtn.innerText = "Searching...";
            showMessage("Loading data, please wait...", "loading");

            try {
                // Fetch data from Google Apps Script
                const response = await fetch(`${WEB_APP_URL}?id=${encodeURIComponent(idInput)}`);
                const json = await response.json();

                if (json.error) {
                    showMessage(json.error, "error");
                } else if (json.success) {
                    showMessage("", "");
                    displayData(json.data);
                }
            } catch (error) {
                showMessage("Connection error. Please try again later.", "error");
            } finally {
                searchBtn.disabled = false;
                searchBtn.innerText = "Search Information";
            }
        }

        function displayData(data) {
            const resultContainer = document.getElementById('resultContainer');
            resultContainer.innerHTML = '';

            // Dynamically create rows for allowed columns
            for (const [key, value] of Object.entries(data)) {
                // Skip empty values for cleaner UI
                if (value === "" || value === null) continue;

                const row = document.createElement('div');
                row.className = 'info-row';
                
                const label = document.createElement('div');
                label.className = 'info-label';
                label.innerText = key; // Column Header
                
                const val = document.createElement('div');
                val.className = 'info-value';
                
                // Format dates nicely if they are ISO strings
                if(typeof value === 'string' && value.match(/^\d{4}-\d{2}-\d{2}T/)) {
                    const date = new Date(value);
                    val.innerText = date.toLocaleDateString('en-GB');
                } else {
                    val.innerText = value;
                }

                row.appendChild(label);
                row.appendChild(val);
                resultContainer.appendChild(row);
            }

            resultContainer.style.display = "block";
        }

        function showMessage(text, type) {
            const messageBox = document.getElementById('messageBox');
            messageBox.innerText = text;
            messageBox.className = "message " + type;
        }
    </script>
